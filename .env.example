HTTP_PORT=8080
ENV=development

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB
DYNAMODB_TABLE=orders

# SNS / SQS (via localstack)
AWS_ENDPOINT_URL=http://localhost:4566
ORDERS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:orders-events-topic
SQS_STOCK_RESERVED_URL=http://localhost:4566/000000000000/orders-stock-reserved-queue
SQS_STOCK_INSUFFICIENT_URL=http://localhost:4566/000000000000/orders-stock-insufficient-queue
SQS_BACKORDER_CREATED_URL=http://localhost:4566/000000000000/orders-backorder-created-queue
SQS_PAYMENT_EVENTS_URL=http://localhost:4566/000000000000/orders-payment-events-queue

# HTTP clients
USERS_BASE_URL=http://localhost:8081
STOCK_BASE_URL=http://localhost:8082
HTTP_CLIENT_TIMEOUT_MS=2000

# Base pública (compõe approval_url no evento order.approval-requested)
PUBLIC_BASE_URL=http://localhost:8080

# Datadog (opcional)
DD_API_KEY=
DD_SITE=datadoghq.com
DD_SERVICE=tech-challenge-api
DD_AGENT_HOST=
